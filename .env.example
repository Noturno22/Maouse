# Copia este ficheiro para .env e preenche as chaves de que precisares.
# (O ficheiro .env NÃO é versionado — está no .gitignore.)

# ─── Provider LLM (assistente "Jarvis" — conversa por voz / comandos por IA) ───
# Escolhe o provider em config.py -> llm_provider (groq | openai | deepseek |
# openrouter | ollama-local).

# Groq (recomendado: gratuito + muito rápido, bom para voz)
GROQ_API_KEY=gsk_...
# A mesma chave GROQ_API_KEY é usada pelo reconhecimento de voz em cloud (STT).

# Ou alternativas (descomenta a que usares):
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# ─── License Server (license-server/) — VARIÁVEIS OBRIGATÓRIAS EM PRODUÇÃO ───
# Sem estas, o servidor de licenças usa valores de DEV inseguros por defeito
# (ver security.py / service.py / storage.py). Em produção, DEFINIR SEMPRE.

# Token de administração p/ emitir chaves (rota /admin/keys) e para /revoke.
# Serve como secret de admin — usa um valor longo e aleatório.
AIRMOUSE_LS_ADMIN_TOKEN=change-me-long-random-token

# Caminho para o ficheiro PEM da chave PRIVADA EC (ES256) do servidor.
# A chave privada NUNCA deve ser versionada (está no .gitignore).
AIRMOUSE_LS_PRIVATE_KEY=C:\path\to\private.pem

# Caminho para o ficheiro PEM da chave PÚBLICA EC correspondente.
# A chave pública deve bater certo com a embutida em core/licensing_public_key.pem.
AIRMOUSE_LS_PUBLIC_KEY=C:\path\to\public.pem

# Caminho opcional da base de dados SQLite. Por omissão: license_server.db na cwd.
# AIRMOUSE_LS_DB=C:\path\to\license.db

# ─── Gerar o par de chaves ES256 (dev/teste) ───
# .venv\Scripts\python.exe license-server\keys.py
# Isto gera private.pem + public.pem. A privada fica SÓ no servidor;
# a pública correspondente é a que vai embutida no cliente (core/licensing_public_key.pem).

# ─── Paddle (D2) — webhook de pagamento automático ───
# Secret do "notification destination" do Paddle (dashboard > Developer tools > Notifications).
# Usado para verificar o header Paddle-Signature no POST /webhooks/paddle.
AIRMOUSE_PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Checkout URLs lidas pelo cliente (core/licensing.py) para abrir o checkout no browser.
AIRMOUSE_PADDLE_LIFETIME_URL=
AIRMOUSE_PADDLE_SUBSCRIPTION_URL=
AIRMOUSE_PADDLE_FAMILY_URL=
AIRMOUSE_PADDLE_ACCESS_URL=

# ─── Email da chave (SMTP, stdlib) — desligado por omissão (dev) ───
# Ligar em produção para que o webhook envie a chave ao comprador.
AIRMOUSE_SMTP_ENABLED=0
AIRMOUSE_SMTP_HOST=smtp.example.com
AIRMOUSE_SMTP_PORT=587
AIRMOUSE_SMTP_USER=your-user
AIRMOUSE_SMTP_PASSWORD=your-password
AIRMOUSE_SMTP_FROM=sales@maouse.app

# ---------------------------------------------------------------------------
# Mobile IAP (Google Play) — validação de compras Pro no license-server
# ---------------------------------------------------------------------------
# JSON da conta de serviço (Google Cloud > APIs & Services > Credentials) com
# permissão "Android Publisher API". Sem isto, o endpoint /api/v1/mobile/entitle
# só funciona em modo dev (ver AIRMOUSE_MOBILE_DEV_ALLOW).
# AIRMOUSE_GOOGLE_PLAY_CREDENTIALS_JSON={"type":"service_account",...}

# Aceitar tokens de teste no endpoint mobile (NUNCA em produção).
AIRMOUSE_MOBILE_DEV_ALLOW=0

# Product ID do 'Mãouse Mobile Pro' (pago único) tal como criado no Play Console.
# Tem de bater certo com app.json -> extra.mobileProductId.
AIRMOUSE_MOBILE_PRODUCT_ID=maouse_mobile_pro