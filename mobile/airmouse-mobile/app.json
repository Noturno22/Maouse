{
  "expo": {
    "name": "Mãouse",
    "slug": "maouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airmouse.mobile",
      "deploymentTarget": "15.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Mãouse precisa de acesso à câmara para detetar gestos de mão",
        "NSMicrophoneUsageDescription": "Mãouse precisa de acesso ao microfone para comandos de voz",
        "NSSiriUsageDescription": "Mãouse pode usar Siri para comandos de voz"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.airmouse.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-vision-camera-v4-mediapipe/plugin",
        {
          "numHands": 2,
          "minDetectionConfidence": 0.5,
          "minPresenceConfidence": 0.5,
          "minTrackingConfidence": 0.5
        }
      ],
      [
        "./plugins/with-airmouse-native",
        {}
      ],
      [
        "expo-dev-client",
        {}
      ],
      [
        "expo-iap",
        {}
      ]
    ],
    "extra": {
      "licenseServerUrl": "https://license.maouse.app",
      "mobileProductId": "maouse_mobile_pro",
      "androidPackage": "com.airmouse.mobile",
      "eas": {
        "projectId": "b411e021-d37e-405f-a287-2e6f8be101b5"
      }
    },
    "owner": "isabel239898"
  }
}
