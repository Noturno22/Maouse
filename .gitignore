# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
*.egg

# Virtual environment
.venv/

# Build / Dist
build/
dist/
*.spec.bak

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
# Os rotados do RotatingFileHandler levam sufixo numerico (airmouse.log.1) e
# nao sao apanhados pelo *.log de cima. Sao MB de diagnostico por arranque.
logs/

# Secrets
.env
.env.*
!.env.example
*.pfx
*.p12
license-server/*.pem
license-server/private.pem
license-server/private_key.pem
# A publica NAO e segredo: e o que o PC embute para validar as leases.
# Versiona-la para o CI poder detectar uma rotacao feita so de um lado
# (foi assim que o desktop passou a rejeitar todas as leases do servidor).
!license-server/public.pem
license-server/*.db
license_server.db
!license-server/keys.py

# Gerado pelo build
version_info.txt

# Endpoint do license-server embebido no build (GERADO por
# tools/gen_license_endpoint.py a partir de MAOUSE_LICENSE_SERVER_URL).
# Fora do git de propósito: é específico de cada build/ambiente.
core/_license_endpoint.py

# Config local do utilizador (calibração, dispositivo de mic, token remoto)
# O exemplo com defaults de fábrica segue commitado em settings.example.json
settings.json
# Token de autenticacao do controlo remoto. Nao e lido por nenhum modulo — o
# token vive em `settings.json` (`remote_token`) e e o `RemoteServer` que o
# gera se estiver vazio — mas um ficheiro com um token na raiz e uma `git add .`
# de森林公园 de o tornar publico. Ignorar e mais barato que confiar.
token.txt
# Playwright MCP (sessoes locais de debug)
.playwright-mcp/
temp_baseline_ref.py
# Dump de debug gerado por tools/debug_cmd_hand.py
tools/cmd_hand_debug.txt

# Node (app movel)
node_modules/
mobile/maouse-mobile/node_modules/

# Sal de identidade da maquina (core/fingerprint.py). Segredo por maquina, nunca commitar.
machine_salt.txt
