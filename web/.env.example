# Copia este ficheiro para `.env.local` e preenche.

# Ligação direta ao instalador Windows (ex.: Vercel Blob / asset estático).
# Se ficar vazio, o botão de download mostra "pré-registo" (mailto suporte@maouse.app).
NEXT_PUBLIC_DOWNLOAD_URL=

# --- Buy flow Paddle (vendor_id) ---
# O vendor_id é o ID numérico da tua conta Paddle (ex.: 12345).
# Definir PADDLE_VENDOR_ID ativa os botões "Comprar" com URLs geradas automaticamente:
#   https://checkout.paddle.com/{vendor_id}?product=maouse-pro-lifetime
#   https://checkout.paddle.com/{vendor_id}?product=maouse-family
#   https://checkout.paddle.com/{vendor_id}?product=maouse-pro-access
#
# Opcionalmente, podes substituir por links diretos (sobrepõe o vendor_id):
#   NEXT_PUBLIC_PADDLE_LIFETIME_URL=https://checkout.paddle.com/.../product=...
#   NEXT_PUBLIC_PADDLE_FAMILY_URL=https://checkout.paddle.com/.../product=...
#   NEXT_PUBLIC_PADDLE_ACCESS_URL=https://checkout.paddle.com/.../product=...
#
# Se tudo ficar vazio, os botões "Comprar" aparecem desativados ("Loja a abrir em breve").
NEXT_PUBLIC_PADDLE_VENDOR_ID=
NEXT_PUBLIC_PADDLE_LIFETIME_URL=
NEXT_PUBLIC_PADDLE_FAMILY_URL=
NEXT_PUBLIC_PADDLE_ACCESS_URL=

# --- Painel "Progresso & Fases" (/admin) ---
# Palavra-passe do painel admin. OBRIGATÓRIO em produção (definir na Vercel).
# Em desenvolvimento, se vazio, usa "dev-admin-token".
ADMIN_TOKEN=
# Segredo para assinar o cookie de sessão (HMAC). OBRIGATÓRIO em produção.
# Em desenvolvimento, se vazio, usa o ADMIN_TOKEN.
ADMIN_SESSION_SECRET=

# --- Vercel Blob (persistência dos dados de progresso) ---
# Gerado por `npx vercel blob` / `vercel env pull` quando existe uma Blob Store.
BLOB_READ_WRITE_TOKEN=
