# Copia este ficheiro para `.env.local` e preenche.

# Ligação direta ao instalador Windows (ex.: Vercel Blob / asset estático).
# Se ficar vazio, o botão de download mostra "pré-registo" (mailto suporte@maouse.app).
NEXT_PUBLIC_DOWNLOAD_URL=

# Base de URL do checkout Paddle (ex.: https://checkout.paddle.com/12345).
# Os planos usam: ?product=maouse-pro-lifetime / maouse-family / maouse-pro-access / maouse-trading-master
# Se ficar vazio, os botões "Comprar" aparecem desativados ("Loja a abrir em breve").
NEXT_PUBLIC_STORE_URL=